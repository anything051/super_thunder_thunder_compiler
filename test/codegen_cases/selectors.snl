{ 选择器示例：数组与记录字段访问 }
PROGRAM selectors
{ 记录类型定义 }
TYPE pair = RECORD
  left, right : INTEGER;
END;
{ 主程序变量 }
VAR nums : ARRAY [1..3] OF INTEGER;
VAR item : pair;
BEGIN
  { 初始化数组并写入记录 }
  nums[1] := 3;
  nums[2] := 7;
  item.left := nums[1];
  item.right := nums[2];
  { 输出记录字段 }
  WRITE(item.left);
  WRITE(item.right);
END
